{% extends 'base.html.twig' %}

{% block title %}Edit version - {{ game.name }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Edit version</h1>
        <p class="page-subtitle">{{ version.name }} · {{ game.name }}</p>
    </div>
    <div class="form-panel">
        {% if version.hasFoto %}
            <img class="thumb" style="width:100%;max-width:280px;border-radius:14px;margin-bottom:1rem" src="{{ path('app_image_game_version', {id: version.id}) }}" alt="">
        {% endif %}
        {{ include('game_version/_form.html.twig') }}
        <a href="{{ path('app_game_show', {id: game.id}) }}" class="back-link">← Cancel</a>
    </div>
{% endblock %}
