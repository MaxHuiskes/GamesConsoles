{% extends 'base.html.twig' %}

{% block title %}Forgot password - GamesConsoles{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Forgot password</h1>
        <p class="page-subtitle">Enter your email and we will send you a reset link.</p>
    </div>

    <div class="form-panel">
        {{ form_start(form) }}
            {{ form_row(form.email) }}
            <div class="btn-group">
                <button type="submit" class="btn btn-primary">Send reset link</button>
                <a href="{{ path('app_login') }}" class="btn btn-secondary">Back to login</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
