{% extends 'base.html.twig' %}

{% block title %}Check your email - GamesConsoles{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Check your email</h1>
        <p class="page-subtitle">If an account exists for that address, a password reset link has been sent.</p>
    </div>

    <div class="form-panel">
        <p>The link expires in 1 hour. Check your spam folder if you do not see the email.</p>
        <a href="{{ path('app_login') }}" class="btn btn-secondary">Back to login</a>
    </div>
{% endblock %}
