{% extends 'base.html.twig' %}

{% block title %}New version - {{ console.name }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>New version</h1>
        <p class="page-subtitle">For {{ console.name }} ({{ console.brand }})</p>
    </div>
    <div class="form-panel">
        {{ include('console_version/_form.html.twig') }}
        <a href="{{ path('app_console_show', {id: console.id}) }}" class="back-link">← Cancel</a>
    </div>
{% endblock %}
