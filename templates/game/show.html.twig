{% extends 'base.html.twig' %}

{% block title %}{{ game.name }} - GamesConsoles{% endblock %}

{% block body %}
    <div class="toolbar">
        <div class="page-header" style="margin-bottom:0">
            <h1>{{ game.name }}</h1>
            <p class="page-subtitle">
                {% if game.consoles is not empty %}
                    <span class="chip-list">
                        {% for console in game.consoles %}
                            <span class="chip">{{ console.brand }} · {{ console }}</span>
                        {% endfor %}
                    </span>
                {% endif %}
                {% if game.consoleVersions is not empty %}
                    <span class="chip-list{% if game.consoles is not empty %} chip-list-spaced{% endif %}">
                        {% for consoleVersion in game.consoleVersions %}
                            <span class="chip chip-version">{{ consoleVersion.console.brand }} · {{ consoleVersion.console }} · {{ consoleVersion.name }}</span>
                        {% endfor %}
                    </span>
                {% endif %}
                {% if game.tags is not empty %}
                    <span class="chip-list{% if game.consoles is not empty or game.consoleVersions is not empty %} chip-list-spaced{% endif %}">
                        {% for tag in game.tags %}
                            <span class="chip chip-tag">{{ tag.name }}</span>
                        {% endfor %}
                    </span>
                {% endif %}
                {% if game.consoles is empty and game.consoleVersions is empty and game.tags is empty %}
                    <span class="meta">No consoles linked</span>
                {% endif %}
            </p>
        </div>
        {% if is_granted('EDIT', game) %}
            <div class="actions">
                <a href="{{ path('app_game_version_new', {game: game.id}) }}" class="btn btn-primary">Add version</a>
                <a href="{{ path('app_game_edit', {id: game.id}) }}" class="btn btn-secondary">Edit</a>
            </div>
        {% endif %}
    </div>

    {% if game.versions is empty %}
        <div class="empty-state">No versions yet. Add e.g. Physical, Digital, GOTY, PAL.</div>
    {% else %}
        <div class="version-grid">
            {% for version in game.versions %}
                {% include '_version_card.html.twig' with {
                    version: version,
                    image_url: path('app_image_game_version', {id: version.id}),
                    edit_url: path('app_game_version_edit', {game: game.id, id: version.id}),
                    delete_url: path('app_game_version_delete', {game: game.id, id: version.id}),
                    readonly: not is_granted('EDIT', game),
                } %}
            {% endfor %}
        </div>
    {% endif %}

    {% if friend is defined %}
        {% if pickConsole is defined and pickConsole %}
            <a href="{{ path('app_friend_pick_console_games', {id: friend.id, consoleId: pickConsole.id}) }}" class="back-link">← Back to {{ pickConsole.name }}</a>
        {% else %}
            <a href="{{ path('app_friend_show', {id: friend.id}) }}" class="back-link">← Back to {{ friend.email }}</a>
        {% endif %}
    {% elseif pickConsole is defined and pickConsole %}
        <a href="{{ path('app_console_picker_games', {id: pickConsole.id, brand: pickBrand.id|default(null)}) }}" class="back-link">← Back to {{ pickConsole.name }}</a>
    {% elseif pickBrand is defined and pickBrand %}
        <a href="{{ path('app_brand_picker_consoles', {id: pickBrand.id}) }}" class="back-link">← Back to {{ pickBrand.name }}</a>
    {% else %}
        <a href="{{ path('app_game_index') }}" class="back-link">← Back to games</a>
    {% endif %}
{% endblock %}
