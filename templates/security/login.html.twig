{% extends 'base.html.twig' %}

{% block title %}Login - GamesConsoles{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Login</h1>
        <p class="page-subtitle">Sign in to your collection.</p>
    </div>

    <div class="form-panel">
        {% if error %}
            <p style="color: var(--danger); margin-bottom: 1rem;">Invalid email or password.</p>
        {% endif %}

        <form method="post">
            <div>
                <label for="username">Email</label>
                <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus>
            </div>
            <div>
                <label for="password">Password</label>
                <input type="password" id="password" name="_password" required>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit" class="btn btn-primary">Login</button>
            <p class="meta" style="margin-top:1rem">Need an account? Ask an existing member for an invite.</p>
        </form>
    </div>
{% endblock %}
