<article class="version-card">
    {% if version.hasFoto %}
        <div class="version-card-image">
            <img src="{{ image_url }}" alt="{{ version.name }}">
        </div>
    {% else %}
        <div class="version-card-placeholder">🎮</div>
    {% endif %}
    <div class="version-card-body">
        <span class="version-card-badge">{{ version.condition }}</span>
        <h2 class="version-card-title">{{ version.name }}</h2>
        <dl class="version-card-meta">
            <dt>Prijs</dt>
            <dd>{% include '_prijs_reveal.html.twig' with {value: version.prijs} %}</dd>
        </dl>
        <div class="version-card-actions actions">
            <a href="{{ edit_url }}" class="btn btn-secondary">Edit</a>
            <form method="post" action="{{ delete_url }}" onsubmit="return confirm('Delete this version?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ version.id) }}">
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>
        </div>
    </div>
</article>
