{% extends 'base.html.twig' %}

{% block title %}New invite - GamesConsoles{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>New invite</h1>
        <p class="page-subtitle">Generate a link for someone to register.</p>
    </div>

    <div class="form-panel">
        {{ form_start(form) }}
            {{ form_row(form.email) }}
            <div class="btn-group">
                <button type="submit" class="btn btn-primary">Create invite</button>
                <a href="{{ path('app_invite_index') }}" class="btn btn-secondary">Cancel</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
