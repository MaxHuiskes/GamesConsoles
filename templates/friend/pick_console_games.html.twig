{% extends 'base.html.twig' %}

{% block title %}{{ console.name }} · {{ friend.email }} - GamesConsoles{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>{{ console.name }}</h1>
        <p class="page-subtitle">
            <span class="chip">{{ console.brand }}</span> · {{ friend.email }}'s games
        </p>
    </div>

    {% if games is empty %}
        <div class="empty-state">No games linked to this console.</div>
    {% else %}
        <div class="picker-grid">
            {% for game in games %}
                <a href="{{ path('app_friend_game_show', {id: friend.id, gameId: game.id, console: console.id}) }}" class="picker-card-link">
                    <article class="picker-item-card">
                        <h2>{{ game.name }}</h2>
                        <p class="picker-item-count">{{ game.versions|length }} version{{ game.versions|length != 1 ? 's' : '' }}</p>
                        {% set other_consoles = game.consoles|filter(c => c.id != console.id) %}
                        {% if other_consoles is not empty %}
                            <p class="meta">Also on: {{ other_consoles|map(c => c.name)|join(', ') }}</p>
                        {% endif %}
                    </article>
                </a>
            {% endfor %}
        </div>
    {% endif %}

    <a href="{{ path('app_friend_show', {id: friend.id}) }}" class="back-link">← Back to {{ friend.email }}</a>
{% endblock %}
