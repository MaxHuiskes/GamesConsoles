{% extends 'base.html.twig' %}

{% block title %}{{ friend.email }} - GamesConsoles{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>{{ friend.email }}</h1>
        <p class="page-subtitle">Friend's collection (read-only).</p>
    </div>

    <div class="stats">
        <div class="stat">
            <strong>{{ brandCount }}</strong>
            <span>Brands</span>
        </div>
        <div class="stat">
            <strong>{{ consoleCount }}</strong>
            <span>Consoles</span>
        </div>
        <div class="stat">
            <strong>{{ consoleVersionCount }}</strong>
            <span>Console versions</span>
        </div>
        <div class="stat">
            <strong>{{ gameCount }}</strong>
            <span>Games</span>
        </div>
        <div class="stat">
            <strong>{{ gameVersionCount }}</strong>
            <span>Game versions</span>
        </div>
    </div>

    <h2>Consoles</h2>
    {% if consoles is empty %}
        <div class="empty-state">No consoles.</div>
    {% else %}
        <div class="panel">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Brand</th>
                        <th>Versions</th>
                        <th>Games</th>
                    </tr>
                </thead>
                <tbody>
                    {% for console in consoles %}
                        <tr>
                            <td><a href="{{ path('app_console_show', {id: console.id}) }}">{{ console.name }}</a></td>
                            <td><span class="chip">{{ console.brand }}</span></td>
                            <td>{{ console.versions|length }}</td>
                            <td>{{ console.games|length }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    <h2>Games</h2>
    {% if games is empty %}
        <div class="empty-state">No games.</div>
    {% else %}
        <div class="panel">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Consoles</th>
                        <th>Versions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for game in games %}
                        <tr>
                            <td><a href="{{ path('app_game_show', {id: game.id}) }}">{{ game.name }}</a></td>
                            <td>
                                <div class="chip-list">
                                    {% for console in game.consoles %}
                                        <span class="chip">{{ console }} ({{ console.brand }})</span>
                                    {% endfor %}
                                </div>
                            </td>
                            <td>{{ game.versions|length }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    <a href="{{ path('app_friend_index') }}" class="back-link">← Back to friends</a>
{% endblock %}
