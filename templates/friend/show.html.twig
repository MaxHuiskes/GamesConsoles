{% extends 'base.html.twig' %}

{% block title %}{{ friend.email }} - GamesConsoles{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>{{ friend.email }}</h1>
        <p class="page-subtitle">Friend's collection (read-only). Pick a console to browse games.</p>
    </div>

    <div class="stats">
        <div class="stat">
            <strong>{{ brandCount }}</strong>
            <span>Brands</span>
        </div>
        <div class="stat">
            <strong>{{ consoleCount }}</strong>
            <span>Consoles</span>
        </div>
        <div class="stat">
            <strong>{{ consoleVersionCount }}</strong>
            <span>Console versions</span>
        </div>
        <div class="stat">
            <strong>{{ gameCount }}</strong>
            <span>Games</span>
        </div>
        <div class="stat">
            <strong>{{ gameVersionCount }}</strong>
            <span>Game versions</span>
        </div>
    </div>

    <h2>Pick a console</h2>
    {% if consoles is empty %}
        <div class="empty-state">No consoles.</div>
    {% else %}
        <div class="picker-grid">
            {% for console in consoles %}
                <a href="{{ path('app_friend_pick_console_games', {id: friend.id, consoleId: console.id}) }}" class="picker-card-link">
                    <article class="picker-item-card">
                        <span class="chip">{{ console.brand }}</span>
                        <h2>{{ console.name }}</h2>
                        <p class="picker-item-count">{{ console.games|length }} game{{ console.games|length != 1 ? 's' : '' }}</p>
                    </article>
                </a>
            {% endfor %}
        </div>
    {% endif %}

    <div class="btn-group">
        <a href="{{ path('app_friend_compare', {id: friend.id}) }}" class="btn btn-primary">Compare collections</a>
        <a href="{{ path('app_friend_index') }}" class="btn btn-ghost">← Back to friends</a>
    </div>
{% endblock %}
