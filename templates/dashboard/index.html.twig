{% extends 'base.html.twig' %}

{% block title %}Dashboard - GamesConsoles{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Dashboard</h1>
        <p class="page-subtitle">Recently added items and stats per brand.</p>
    </div>

    <div class="stats">
        <div class="stat">
            <strong>{{ brandCount }}</strong>
            <span>Brands</span>
        </div>
        <div class="stat">
            <strong>{{ consoleCount }}</strong>
            <span>Consoles</span>
        </div>
        <div class="stat">
            <strong>{{ consoleVersionCount }}</strong>
            <span>Console versions</span>
        </div>
        <div class="stat">
            <strong>{{ gameCount }}</strong>
            <span>Games</span>
        </div>
        <div class="stat">
            <strong>{{ gameVersionCount }}</strong>
            <span>Game versions</span>
        </div>
    </div>

    <h2>Recently added</h2>
    {% if recentItems is empty %}
        <div class="empty-state">Nothing added yet.</div>
    {% else %}
        <div class="panel">
            <table>
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Type</th>
                        <th>Item</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in recentItems %}
                        <tr>
                            <td class="meta">{{ item.createdAt|date('Y-m-d H:i') }}</td>
                            <td><span class="chip">{{ item.type }}</span></td>
                            <td><a href="{{ path(item.routeName, item.routeParams) }}">{{ item.label }}</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    <h2>Stats per brand</h2>
    {% if brandStats is empty %}
        <div class="empty-state">No brands yet. <a href="{{ path('app_brand_new') }}">Add a brand</a>.</div>
    {% else %}
        <div class="panel">
            <table>
                <thead>
                    <tr>
                        <th>Brand</th>
                        <th>Consoles</th>
                        <th>Games</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in brandStats %}
                        <tr>
                            <td><a href="{{ path('app_brand_edit', {id: row.brand.id}) }}">{{ row.brand.name }}</a></td>
                            <td>{{ row.consoleCount }}</td>
                            <td>{{ row.gameCount }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    <a href="{{ path('app_home') }}" class="back-link">← Back to home</a>
{% endblock %}
